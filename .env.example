# ============================================
# AIVEN KAFKA CONFIGURATION (Required for Production)
# ============================================
# Get these values from: https://console.aiven.io/ > Your Project > Kafka > Service URI

# Aiven Kafka bootstrap server (format: hostname:port)
# Example: demo-aiven-kafka.aivencloud.com:12345

# Aiven Kafka authentication username
# Example: avnadmin


# Aiven Kafka authentication password


# SSL Certificate file path (optional, usually not needed with SASL_SSL)
# AIVEN_SSL_CA_FILE=/path/to/ca.pem

# ============================================
# KAFKA TOPICS (Optional - defaults provided)
# ============================================
KAFKA_PRODUCT_TOPIC=product-topic
KAFKA_INVENTORY_TOPIC=inventory-topic
KAFKA_ORDER_TOPIC=order-topic
KAFKA_PAYMENT_TOPIC=payment-topic
KAFKA_USER_TOPIC=user-topic
KAFKA_DESIGN_TOPIC=design-topic

# Consumer Group IDs (Optional - defaults provided)
KAFKA_CONSUMER_GROUP_ID_FOR_PRODUCT=product-group
KAFKA_CONSUMER_GROUP_ID_FOR_INVENTORY=inventory-group
KAFKA_CONSUMER_GROUP_ID_FOR_ORDER=order-group
KAFKA_CONSUMER_GROUP_ID_FOR_PAYMENT=payment-group
KAFKA_CONSUMER_GROUP_ID_FOR_USER=user-group
KAFKA_CONSUMER_GROUP_ID_FOR_DESIGN=ai-design-group

# ============================================
# SERVICE DATABASE URLs
# ============================================
# Format: postgresql://username:password@hostname:port/database_name
PRODUCT_SERVICE_DATABASE_URL=postgresql://postgres:postgres@product_db:5432/products
INVENTORY_SERVICE_DATABASE_URL=postgresql://postgres:postgres@inventory_db:5432/inventory
USER_SERVICE_DATABASE_URL=postgresql://postgres:postgres@user_db:5432/users
ORDER_SERVICE_DATABASE_URL=postgresql://postgres:postgres@order_db:5432/orders
PAYMENT_SERVICE_DATABASE_URL=postgresql://postgres:postgres@payment_db:5432/payments

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHMS=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google OAuth (for user_services)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ============================================
# AI SERVICES
# ============================================
GEMINI_API_KEY=your-gemini-api-key
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=online-mart-products
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
FLUX_IMAGE_MODEL=black-forest-labs/flux-schnell

# ============================================
# EMAIL NOTIFICATIONS (SMTP)
# ============================================
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password

# ============================================
# QUICK START
# ============================================
#
# Production Deployment with Aiven Kafka
# ------------------------------------------
# 1. Copy this file to .env
# 2. Fill in AIVEN_KAFKA_* variables from Aiven Console
# 3. Run: docker compose up -d
# 4. Services will connect to Aiven Cloud Kafka
#
# For detailed setup instructions, see: AIVEN_KAFKA_SETUP.md
