# Environment variables for Azure Container Apps deployment
# These values should be replaced with actual values during deployment

# Database URLs - these will be constructed during deployment using Azure PostgreSQL
PRODUCT_SERVICE_DATABASE_URL=postgresql://${POSTGRES_ADMIN_USER}:${POSTGRES_ADMIN_PASSWORD}@${POSTGRES_FQDN}:5432/products_db
INVENTORY_SERVICE_DATABASE_URL=postgresql://${POSTGRES_ADMIN_USER}:${POSTGRES_ADMIN_PASSWORD}@${POSTGRES_FQDN}:5432/inventory_db
USER_SERVICE_DATABASE_URL=postgresql://${POSTGRES_ADMIN_USER}:${POSTGRES_ADMIN_PASSWORD}@${POSTGRES_FQDN}:5432/users_db
ORDER_SERVICE_DATABASE_URL=postgresql://${POSTGRES_ADMIN_USER}:${POSTGRES_ADMIN_PASSWORD}@${POSTGRES_FQDN}:5432/orders_db
NOTIFICATION_SERVICE_DATABASE_URL=postgresql://${POSTGRES_ADMIN_USER}:${POSTGRES_ADMIN_PASSWORD}@${POSTGRES_FQDN}:5432/notifications_db
PAYMENT_SERVICE_DATABASE_URL=postgresql://${POSTGRES_ADMIN_USER}:${POSTGRES_ADMIN_PASSWORD}@${POSTGRES_FQDN}:5432/payments_db
AI_CENTER_DATABASE_URL=postgresql://${POSTGRES_ADMIN_USER}:${POSTGRES_ADMIN_PASSWORD}@${POSTGRES_FQDN}:5432/ai_center_db

# Kafka configuration for Azure Event Hubs (Kafka-compatible)
KAFKA_BOOTSTRAP_SERVER=onlinemartkafka.servicebus.windows.net:9093
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_JAAS_CONFIG=org.apache.kafka.common.security.plain.PlainLoginModule required username='$ConnectionString' password='Endpoint=sb://onlinemartkafka.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=${EVENTHUB_SHARED_ACCESS_KEY}';

# Kafka Topics
KAFKA_PRODUCT_TOPIC=product-topic
KAFKA_INVENTORY_TOPIC=inventory-topic
KAFKA_USER_TOPIC=user-topic
KAFKA_ORDER_TOPIC=order-topic
KAFKA_NOTIFICATION_TOPIC=notification-topic
KAFKA_PAYMENT_TOPIC=payment-topic
KAFKA_DESIGN_TOPIC=design-topic

# Consumer Groups
KAFKA_CONSUMER_GROUP_ID_FOR_PRODUCT=product-group
KAFKA_CONSUMER_GROUP_ID_FOR_INVENTORY=inventory-group
KAFKA_CONSUMER_GROUP_ID_FOR_USER=user-group
KAFKA_CONSUMER_GROUP_ID_FOR_ORDER=order-group
KAFKA_CONSUMER_GROUP_ID_FOR_NOTIFICATION=notification-group
KAFKA_CONSUMER_GROUP_ID_FOR_PAYMENT=payment-group
KAFKA_CONSUMER_GROUP_ID=ai-design-group

# AI Services
GEMINI_API_KEY=${GEMINI_API_KEY}
PINECONE_API_KEY=${PINECONE_API_KEY}
PINECONE_INDEX_NAME=${PINECONE_INDEX_NAME}
OPENROUTER_API_KEY=${OPENROUTER_API_KEY}
OPENROUTER_BASE_URL=${OPENROUTER_BASE_URL}
OPENROUTER_MODEL=${OPENROUTER_MODEL}
FLUX_IMAGE_MODEL=${FLUX_IMAGE_MODEL}

# Security
SECRET_KEY=${SECRET_KEY}
ALGORITHMS=${ALGORITHMS}
GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}